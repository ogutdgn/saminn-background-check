{
  "openapi": "3.1.0",
  "info": {
    "title": "The Samaritan Inn \u2014 Background Search",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "post": {
        "summary": "Search",
        "description": "Fan `query` out to the enabled sources; stream one SSE `result` event per source,\nthen a final `done` event. A source that errors emits a `result` with status `error`\n\u2014 it never breaks the stream for the others.",
        "operationId": "search_api_search_post",
        "parameters": [
          {
            "name": "staff",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Staff"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdapterResult"
                }
              },
              "text/event-stream": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdapterResult": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "status": {
            "$ref": "#/components/schemas/AdapterStatus"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/InmateRecord"
            },
            "type": "array",
            "title": "Records"
          },
          "total": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total"
          },
          "duration_ms": {
            "type": "integer",
            "title": "Duration Ms"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "source",
          "display_name",
          "status",
          "duration_ms"
        ],
        "title": "AdapterResult",
        "description": "One source's outcome for one search \u2014 the unit the orchestrator streams."
      },
      "AdapterStatus": {
        "type": "string",
        "enum": [
          "ok",
          "no_results",
          "error",
          "timeout"
        ],
        "title": "AdapterStatus"
      },
      "Charge": {
        "properties": {
          "offense": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Offense"
          },
          "case_no": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case No"
          },
          "warrant_no": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Warrant No"
          },
          "disposition": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disposition"
          },
          "extra": {
            "additionalProperties": true,
            "type": "object",
            "title": "Extra"
          }
        },
        "type": "object",
        "title": "Charge"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InmateRecord": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "year_of_birth": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year Of Birth"
          },
          "sex": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sex"
          },
          "booking_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Booking Date"
          },
          "photo_base64": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Photo Base64"
          },
          "charges": {
            "items": {
              "$ref": "#/components/schemas/Charge"
            },
            "type": "array",
            "title": "Charges"
          },
          "matched_on": {
            "items": {
              "$ref": "#/components/schemas/MatchInfo"
            },
            "type": "array",
            "title": "Matched On"
          },
          "raw": {
            "additionalProperties": true,
            "type": "object",
            "title": "Raw"
          }
        },
        "type": "object",
        "required": [
          "source",
          "name"
        ],
        "title": "InmateRecord"
      },
      "MatchInfo": {
        "properties": {
          "type": {
            "$ref": "#/components/schemas/MatchType"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "type"
        ],
        "title": "MatchInfo"
      },
      "MatchType": {
        "type": "string",
        "enum": [
          "name",
          "alias",
          "attorney",
          "other"
        ],
        "title": "MatchType",
        "description": "WHY a row matched the query \u2014 lets the UI surface real-name hits and hide\nattorney/alias noise. Tagging this correctly per source is the adapter's job."
      },
      "SearchQuery": {
        "properties": {
          "last": {
            "type": "string",
            "title": "Last"
          },
          "first": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First"
          },
          "middle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Middle"
          },
          "sex": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Sex"
              },
              {
                "type": "null"
              }
            ]
          },
          "year_of_birth": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year Of Birth"
          },
          "max_results": {
            "type": "integer",
            "title": "Max Results",
            "default": 25
          }
        },
        "type": "object",
        "required": [
          "last"
        ],
        "title": "SearchQuery",
        "description": "The normalized search input.\n\n`last` is the only required field \u2014 every source searches by surname. The\noptional fields refine the search where a source's form supports them, and are\nused to rank/filter results client-side where it doesn't. (Government search\nfields are dirty \u2014 e.g. Dallas DOB is often masked \u2014 so we prefer searching\nbroad and ranking, over pushing filters into each site. See docs/ARCHITECTURE.)"
      },
      "Sex": {
        "type": "string",
        "enum": [
          "M",
          "F",
          "U"
        ],
        "title": "Sex"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}